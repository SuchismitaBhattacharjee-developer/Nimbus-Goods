{
  "name": "nimbus-goods",
  "private": true,
  "description": "A tiny embeddable checkout: SDK + hosted checkout app + demo store.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build && node scripts/assemble.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
