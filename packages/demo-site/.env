# Where the store loads the Dodo Checkout SDK from. The SDK opens the checkout that lives
# next to it (<base>/sdk/dodo-checkout.js -> <base>/checkout/), so this is the only knob.
#
# Default: same deployment. To serve the checkout from its own origin, point this at it,
# e.g. VITE_DODO_SDK_URL=https://checkout.example.com/sdk/dodo-checkout.js
VITE_DODO_SDK_URL=/sdk/dodo-checkout.js
